diff --git a/src/Mod/Import/importtests/TestImportDXF.py b/src/Mod/Import/importtests/TestImportDXF.py
index b6f6bf0..b42c52c 100644
--- a/src/Mod/Import/importtests/TestImportDXF.py
+++ b/src/Mod/Import/importtests/TestImportDXF.py
@@ -1416,0 +1417,36 @@ class TestImportDXF(TestImportBase):
+    def test_direct_insert_geometry_overflow_and_array_retry(self):
+        """Do not publish a direct INSERT or partial array with overflowing geometry."""
+        options = FreeCAD.ParamGet(self.option_source)
+        for mode in (2, 3):
+            options.SetInt("DxfImportMode", mode)
+            for is_array in (False, True):
+                with self.subTest(mode=mode, array=is_array):
+                    tags = [(0, "SECTION"), (2, "HEADER"), (9, "$ACADVER"), (1, "AC1021"),
+                            (9, "$INSUNITS"), (70, 4), (0, "ENDSEC"), (0, "SECTION"),
+                            (2, "BLOCKS"), (0, "BLOCK"), (8, "0"), (2, "B"), (70, 0),
+                            (10, 1), (20, 0), (30, 0), (0, "LINE"), (8, "0"),
+                            (10, 1), (20, 0), (30, 0), (11, 3), (21, 0), (31, 0),
+                            (0, "ENDBLK"), (8, "0"), (0, "ENDSEC"),
+                            (0, "SECTION"), (2, "ENTITIES"), (0, "INSERT"), (8, "0"), (2, "B")]
+                    if is_array:
+                        # First instance is finite; the second overflows after translation.
+                        tags.extend([(41, "1e307"), (70, 2), (44, "1.7e308")])
+                    else:
+                        tags.append((41, "1e308"))
+                    tags.extend([(0, "INSERT"), (8, "0"), (2, "B"), (10, 10),
+                                 (0, "INSERT"), (8, "0"), (2, "B"), (41, "1e10"),
+                                 (0, "ENDSEC"), (0, "EOF")])
+                    path = os.path.join(self.temp_dir, f"overflow-geometry-{mode}-{is_array}.dxf")
+                    with open(path, "w", encoding="ascii", newline="\n") as stream:
+                        stream.write("".join(f"{code}\n{value}\n" for code, value in tags))
+                    previous = set(self.document.Objects)
+                    stats = Import.readDXF(path, self.document.Name, True, self.option_source)
+                    self.document.recompute()
+                    links = [obj for obj in self.document.Objects if obj not in previous
+                             and obj.Name.startswith("Link_B")]
+                    self.assertEqual(len(stats["unsupportedFeatures"]["INSERT geometry transform overflow"]), 1)
+                    self.assertEqual(len(links), 2)
+                    spans = sorted(tuple(sorted(v.Point.x for v in link.Shape.Edges[0].Vertexes))
+                                   for link in links)
+                    self.assertEqual(spans, [(0, 2e10), (10, 12)])
+
