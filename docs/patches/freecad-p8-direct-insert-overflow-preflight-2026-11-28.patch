diff --git a/src/Mod/Import/App/dxf/ImpExpDxf.cpp b/src/Mod/Import/App/dxf/ImpExpDxf.cpp
index d20ab0a..5834397 100644
--- a/src/Mod/Import/App/dxf/ImpExpDxf.cpp
+++ b/src/Mod/Import/App/dxf/ImpExpDxf.cpp
@@ -1535,0 +1536,53 @@ void ImpExpDxfRead::OnReadSolid(
+bool ImpExpDxfRead::CanReadInsert(
+    const Base::Vector3d& point,
+    const Base::Vector3d& scale,
+    const std::string& name,
+    double rotation
+)
+{
+    // Only direct drawing instances with no nested references are covered here.
+    // The bounds are checked before creating any member of an INSERT array.
+    if (dynamic_cast<DrawingEntityCollector*>(Collector) == nullptr) return true;
+    const auto block = Blocks.find(name);
+    if (block == Blocks.end() || !block->second.Inserts.empty()) return true;
+
+    Base::Matrix4D transform;
+    transform.scale(scale);
+    Base::Matrix4D rotate;
+    rotate.rotZ(rotation);
+    transform = OCSOrientationTransform * rotate * transform;
+    transform.move(OCSOrientationTransform * point);
+    auto cached = m_directBlockBounds.find(name);
+    if (cached == m_directBlockBounds.end()) {
+        Base::BoundBox3d bounds;
+        try {
+            for (const auto& entry : block->second.GeometryBuilders) {
+                for (const auto& builder : entry.second) {
+                    if (builder.shape.IsNull()) continue;
+                    const auto part = Part::TopoShape(builder.shape).getBoundBox();
+                    if (!part.IsValid() || !std::isfinite(part.MinX) || !std::isfinite(part.MinY)
+                        || !std::isfinite(part.MinZ) || !std::isfinite(part.MaxX)
+                        || !std::isfinite(part.MaxY) || !std::isfinite(part.MaxZ)) {
+                        m_invalidDirectBlockBounds.insert(name);
+                    }
+                    else bounds.Add(part);
+                }
+            }
+        }
+        catch (const Standard_Failure&) {
+            m_invalidDirectBlockBounds.insert(name);
+        }
+        cached = m_directBlockBounds.emplace(name, bounds).first;
+    }
+    if (m_invalidDirectBlockBounds.count(name)) return false;
+    // An annotation-only block has no geometric bounds to inspect.
+    if (!cached->second.IsValid()) return true;
+    for (unsigned short i = 0; i < 8; ++i) {
+        const auto corner = cached->second.CalcPoint(i) - block->second.BasePoint;
+        const auto result = transform * corner;
+        if (!std::isfinite(result.x) || !std::isfinite(result.y)
+            || !std::isfinite(result.z)) return false;
+    }
+    return true;
+}
+
