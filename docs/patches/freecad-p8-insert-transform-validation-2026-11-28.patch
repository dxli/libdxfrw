@@ -2854,0 +2850,4 @@ bool CDxfRead::ReadInsert()
+    // Process transform values strictly: accepting a numeric prefix, repeated
+    // field, or singular scale would silently place different geometry.
+    bool invalidTransform = false;
+    bool seenTransform[7] = {};
@@ -2866,0 +2866,21 @@ bool CDxfRead::ReadInsert()
+        const int transformField = code == 10 ? 0 : code == 20 ? 1 : code == 30 ? 2
+                                 : code == 41 ? 3 : code == 42 ? 4 : code == 43 ? 5
+                                 : code == 50 ? 6 : -1;
+        if (transformField >= 0) {
+            double value = 0;
+            if (seenTransform[transformField] || !parseCompleteNumber(m_record_data, value)
+                || !std::isfinite(value)) {
+                invalidTransform = true;
+            }
+            else {
+                if (transformField < 3) value = mm(value);
+                if (!std::isfinite(value)) invalidTransform = true;
+                else {
+                    double* values[] = {&center.x, &center.y, &center.z,
+                                        &scale.x, &scale.y, &scale.z, &rotationDegrees};
+                    *values[transformField] = value;
+                }
+            }
+            seenTransform[transformField] = true;
+            continue;
+        }
@@ -2910,0 +2931,5 @@ bool CDxfRead::ReadInsert()
+    if (invalidTransform || scale.x == 0.0 || scale.y == 0.0 || scale.z == 0.0
+        || !std::isfinite(Base::toRadians(rotationDegrees))) {
+        UnsupportedFeature("INSERT invalid transform");
+        return true;
+    }
