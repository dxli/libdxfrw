if(NOT DEFINED CONTENT_TEST OR NOT DEFINED DATA_TEST OR NOT DEFINED GEOMETRY_TEST OR NOT DEFINED ROOT_TEST OR NOT DEFINED STYLE_TEST OR NOT DEFINED DICTIONARY_TEST OR NOT DEFINED BIND_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing generated full-bundle test paths")
endif()
if(EXISTS "${TEST_DIR}")
    message(FATAL_ERROR "Scratch test directory already exists: ${TEST_DIR}")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(content "${TEST_DIR}/content.bin")
set(data "${TEST_DIR}/data.bin")
set(geometry "${TEST_DIR}/geometry.bin")
set(root "${TEST_DIR}/root.bin")
set(style "${TEST_DIR}/style.bin")
set(dictionary "${TEST_DIR}/dictionary.bin")
set(dwg "${TEST_DIR}/generated.dwg")
execute_process(COMMAND "${CONTENT_TEST}" --emit-body "${content}" RESULT_VARIABLE c)
execute_process(COMMAND "${DATA_TEST}" --emit-nine "${data}" RESULT_VARIABLE d)
execute_process(COMMAND "${GEOMETRY_TEST}" --emit-body "${geometry}" RESULT_VARIABLE g)
execute_process(COMMAND "${ROOT_TEST}" --emit-body "${root}" RESULT_VARIABLE r)
execute_process(COMMAND "${STYLE_TEST}" --emit-body "${style}" RESULT_VARIABLE s)
execute_process(COMMAND "${DICTIONARY_TEST}" --emit-body "${dictionary}" RESULT_VARIABLE k)
if(NOT c EQUAL 0 OR NOT d EQUAL 0 OR NOT g EQUAL 0 OR NOT r EQUAL 0 OR NOT s EQUAL 0 OR NOT k EQUAL 0)
    file(REMOVE_RECURSE "${TEST_DIR}")
    message(FATAL_ERROR "Could not generate scratch source bodies")
endif()
execute_process(COMMAND "${BIND_TEST}" "${content}" "${data}" "${geometry}" "${root}" "${style}" "${dictionary}" "${dwg}" RESULT_VARIABLE result)
file(REMOVE_RECURSE "${TEST_DIR}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Generated full-bundle control failed: ${result}")
endif()
