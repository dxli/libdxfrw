if(NOT DEFINED BODY_TEST OR NOT DEFINED LEASE_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing reader-lease test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(body "${TEST_DIR}/body.bin")
file(REMOVE "${body}")
execute_process(COMMAND "${BODY_TEST}" --emit-body "${body}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch TABLE body")
endif()
execute_process(COMMAND "${LEASE_TEST}" "${body}" RESULT_VARIABLE result)
file(REMOVE "${body}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Reader lease test failed: ${result}")
endif()
