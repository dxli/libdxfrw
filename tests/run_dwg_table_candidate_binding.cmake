if(NOT DEFINED CONTENT_TEST OR NOT DEFINED DATA_TEST OR NOT DEFINED BIND_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing candidate binding test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(content "${TEST_DIR}/content.bin")
set(largeContent "${TEST_DIR}/large-content.bin")
set(data "${TEST_DIR}/data.bin")
set(bad "${TEST_DIR}/bad-role.bin")
set(dwg "${TEST_DIR}/generated.dwg")
file(REMOVE "${content}" "${largeContent}" "${data}" "${bad}" "${dwg}" "${dwg}.bad.dwg")
execute_process(COMMAND "${CONTENT_TEST}" --emit-body "${content}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch TABLECONTENT body")
endif()
execute_process(COMMAND "${DATA_TEST}" --emit-body "${data}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch DATATABLE body")
endif()
execute_process(COMMAND "${DATA_TEST}" --emit-bad-role "${bad}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch bad-role body")
endif()
execute_process(COMMAND "${CONTENT_TEST}" --emit-large-body "${largeContent}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch larger TABLECONTENT body")
endif()
execute_process(COMMAND "${BIND_TEST}" "${content}" "${data}" "${bad}" "${largeContent}" "${dwg}"
    RESULT_VARIABLE result)
file(REMOVE "${content}" "${largeContent}" "${data}" "${bad}" "${dwg}" "${dwg}.bad.dwg")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Combined candidate binding test failed: ${result}")
endif()
