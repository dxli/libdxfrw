if(NOT DEFINED BODY_TEST OR NOT DEFINED READER_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing generated CELLSTYLEMAP reader test paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(body "${TEST_DIR}/generated-cellstylemap-body.bin")
file(REMOVE "${body}")
execute_process(COMMAND "${BODY_TEST}" --emit-body "${body}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate scratch CELLSTYLEMAP body")
endif()
execute_process(COMMAND "${READER_TEST}" "${body}" RESULT_VARIABLE result)
file(REMOVE "${body}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Generated CELLSTYLEMAP reader test failed: ${result}")
endif()
