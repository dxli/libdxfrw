set(source "${OUTPUT_DIR}/sunstudy-graph-source.dxf")
file(REMOVE "${source}")
execute_process(COMMAND "${PYTHON}" "${AUTHOR}" author "${source}" RESULT_VARIABLE authored)
if(NOT authored EQUAL 0)
    message(FATAL_ERROR "SUNSTUDY scratch author failed: ${authored}")
endif()
execute_process(COMMAND "${ADAPTER_TEST}" --sunstudy-dxf-graph "${source}" RESULT_VARIABLE result)
file(REMOVE "${source}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SUNSTUDY graph controls failed: ${result}")
endif()
