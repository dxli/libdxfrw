if(NOT DEFINED BODY_TEST OR NOT DEFINED LEASE_TEST OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing style dictionary reader-lease paths")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(body "${TEST_DIR}/body.bin")
set(bad "${TEST_DIR}/bad.bin")
set(swapped "${TEST_DIR}/swapped.bin")
set(reversed "${TEST_DIR}/reversed.bin")
file(REMOVE "${body}" "${bad}" "${swapped}" "${reversed}")
execute_process(COMMAND "${BODY_TEST}" --emit-body "${body}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate style dictionary body")
endif()
execute_process(COMMAND "${BODY_TEST}" --emit-bad-role "${bad}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate wrong-role dictionary body")
endif()
execute_process(COMMAND "${BODY_TEST}" --emit-swapped "${swapped}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate swapped-target dictionary body")
endif()
execute_process(COMMAND "${BODY_TEST}" --emit-reversed "${reversed}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not generate reversed-key dictionary body")
endif()
execute_process(COMMAND "${LEASE_TEST}" "${body}" "${bad}" "${swapped}" "${reversed}" RESULT_VARIABLE result)
file(REMOVE "${body}" "${bad}" "${swapped}" "${reversed}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Style dictionary reader lease failed: ${result}")
endif()
